<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình chính (giao diện sáng): logo, trạng thái TV, 2 nút lớn Kết nối TV / Sử dụng chiếu -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxWidth="460dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="Biểu tượng Máy Chiếu"
                android:elevation="6dp"
                android:src="@drawable/logo_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Máy Chiếu"
                android:textColor="#FF0F172A"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Chiếu bài làm của học sinh lên TV"
                android:textColor="#FF64748B"
                android:textSize="15sp" />

            <!-- Trạng thái TV -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_home_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_off" />
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Chưa kết nối TV"
                    android:textColor="#FF334155"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Kích hoạt bản quyền (chỉ hiện khi máy chưa kích hoạt) -->
            <LinearLayout
                android:id="@+id/activateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kích hoạt app"
                    android:textColor="#FF0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nhập mã kích hoạt trong link bạn đã nhận khi mua app. Chỉ cần kích hoạt 1 lần, dùng vĩnh viễn trên máy này."
                    android:textColor="#FF64748B"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/codeInput"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_connect"
                    android:gravity="center"
                    android:hint="ABCD-2345"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:letterSpacing="0.12"
                    android:maxLength="12"
                    android:textColor="#FF0F172A"
                    android:textColorHint="#FFB6C2D2"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/activateBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_start"
                    android:text="Kích hoạt"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/activateMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="#FFE5484D"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Nút 1: Kết nối TV -->
            <LinearLayout
                android:id="@+id/cardConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_connect"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="96dp"
                android:orientation="horizontal"
                android:padding="18dp">
                <FrameLayout
                    android:id="@+id/connectIconBg"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_light">
                    <ImageView
                        android:id="@+id/connectIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cast"
                        android:tint="#FF2B5FE8" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/connectTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kết nối TV"
                        android:textColor="#FF0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/connectSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Chọn TV để chiếu màn hình (Smart View)"
                        android:textColor="#FF64748B"
                        android:textSize="13sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    android:tint="#FF94A3B8" />
            </LinearLayout>

            <!-- Nút 2: Sử dụng chiếu -->
            <LinearLayout
                android:id="@+id/cardStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_start"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="96dp"
                android:orientation="horizontal"
                android:padding="18dp">
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_dark">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sử dụng chiếu"
                        android:textColor="#FFFFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mở camera để chiếu bài làm"
                        android:textColor="#D9FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <!-- Nút 3: Kho ảnh -->
            <LinearLayout
                android:id="@+id/cardGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_connect"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="96dp"
                android:orientation="horizontal"
                android:padding="18dp">
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_light">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_gallery"
                        android:tint="#FF2B5FE8" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kho ảnh"
                        android:textColor="#FF0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ảnh bài làm đã lưu, có tên học sinh"
                        android:textColor="#FF64748B"
                        android:textSize="13sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    android:tint="#FF94A3B8" />
            </LinearLayout>

            <!-- Nút 4: So sánh bài tập -->
            <LinearLayout
                android:id="@+id/cardCompare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_connect"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="96dp"
                android:orientation="horizontal"
                android:padding="18dp">
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_light">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_compare"
                        android:tint="#FF2B5FE8" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="So sánh bài tập"
                        android:textColor="#FF0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Chọn 2 ảnh, chia đôi màn hình để so sánh"
                        android:textColor="#FF64748B"
                        android:textSize="13sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    android:tint="#FF94A3B8" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mẹo dùng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_home_card"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tip"
                android:tint="#FFF59E0B" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="1. Bấm Kết nối TV và chọn TV của lớp.\n2. Bấm Sử dụng chiếu, đặt camera trên bài làm.\n3. Bấm nút tròn con mắt để TV chỉ hiện hình."
                android:textColor="#FF475569"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FF94A3B8"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
