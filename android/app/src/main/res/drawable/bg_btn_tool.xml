<?xml version="1.0" encoding="utf-8"?>
<!-- Nút trên thanh công cụ có trạng thái bật (xanh khi đang chiếu lên TV) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="#FF2E9BD6"/><corners android:radius="14dp"/></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#33FFFFFF"/><corners android:radius="14dp"/></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000"/><corners android:radius="14dp"/></shape></item>
</selector>
