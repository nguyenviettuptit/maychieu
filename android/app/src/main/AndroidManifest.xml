<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyền camera. Internet chỉ dùng 1 lần khi kích hoạt bản quyền. Không micro, không vị trí. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lưu ảnh trên Android 9 trở xuống (Android 10+ không cần quyền này) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- Để mở được Smart View (chiếu màn hình) của Samsung -->
    <queries>
        <package android:name="com.samsung.android.smartmirroring" />
        <intent>
            <action android:name="android.settings.CAST_SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <!-- Màn hình chính (giao diện sáng): Kết nối TV / Sử dụng chiếu -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:theme="@style/HomeTheme"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Nút "Kích hoạt app" trên trang tải: maychieu://activate?t=MÃ -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="maychieu" android:host="activate" />
            </intent-filter>
        </activity>

        <!-- Màn hình chiếu: camera toàn màn hình -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- Chỉnh sửa ảnh: vẽ chú thích lên ảnh vừa chụp hoặc ảnh trong Kho ảnh -->
        <activity
            android:name=".PhotoEditorActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- Kho ảnh: danh sách ảnh đã lưu -->
        <activity
            android:name=".GalleryActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- So sánh bài tập: chọn 2 ảnh, chia đôi màn hình -->
        <activity
            android:name=".CompareActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
    </application>
</manifest>
